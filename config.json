{
    // =========================================================================
    // itquiz — a quiz against the confusions a layperson carries.
    //
    // The facts are stored correct and nothing else: a browser displays pages, a
    // search engine keeps an index and is itself a website, a spider builds that
    // index. No wrong sentence lives anywhere in the store — the confusion is in
    // the reader, and the cure is a correct fact plus a question that makes the
    // distinction visible. Decided at genesis (docs/Genesis.md § 2).
    //
    // The MODEL is English like every repo artefact; only the question texts are
    // multilingual, because they are the one thing a learner reads.
    // =========================================================================

    // Next free port after gametracker (18393). `--aitest` overrides to 18349.
    "port": 18394,
    "log_level": "INFO",

    "titleHtml": "<span style='color:#9ca3af; font-size:0.9em'>🧩 <b>ITQUIZ</b> — Begriffe der IT, sortiert</span>",

    "auth": {
        "enabled": true,
        "mode": "users",

        // Per-user history is the point of the system, so there is a real account
        // per learner from the start — a role trias would make every learner the
        // same person and the history meaningless.
        "initialAdmin": {
            "username": "admin",
            "displayName": "Administrator",
            "password": "4f6420a8b3d7b39457638dfa674d94c3a93acc5bde41323eb06d7ab1224395de"
        },

        // The player role, and what it may read.
        //
        // `AskedQuestion` is deliberately ABSENT from this list. One player must
        // not be able to read another's history through /api/entities, and no
        // create permission can express "only your own row" — so the log is
        // written by the system route, which takes the owner from the session.
        // Same seam, same reason, as aide-lerntrainer.
        "systemRoles": [
            {
                "name": "player",
                "displayName": "Player",
                "description": "Answers questions and sees nothing but the quiz. The facts are readable; the history of who was asked what is not.",
                "permissions": {
                    "entities": {
                        "Company": "r",
                        "ProductType": "r",
                        "ProductTypeText": "r",
                        "Product": "r",
                        "QuestionTemplate": "r",
                        "QuestionPhrase": "r"
                    },
                    "views": {},
                    "processes": {},
                    "admin": false
                },
                "sortOrder": 20
            }
        ],
        // A player signs in and lands IN THE QUIZ, not in a CRUD table. The
        // whole point of the system is that it works for someone who would not
        // know what an entity is.
        "loginActions": {
            "player": {
                "handler": "sys/quiz/quiz.html",
                "mode": "fullPage",
                "label": "Quiz",
                // The quiz hands its player a link — „🔎 Im Katalog ansehen", at the record a
                // question was about — and without this the new window would be redirected
                // straight back into a second copy of the quiz (aide-rap#503). Only a load
                // carrying `?crumbs=` passes; a bare `/` still lands here. What the player
                // then sees is decided by the role's permissions, not by this line.
                "deepLinkEscapes": true
            }
        },
        "sessionTimeoutInactive": 3600,
        "sessionTimeoutAbsolute": 86400
    },

    "docsEditable": true,
    "helpEditable": true,

    // Where this system's own CRs live — without it the footer 🐛 anchor is never
    // built, so the tracker is reachable from nowhere in the running system.
    "githubRepo": "aide-examples/aide-itquiz",

    "pwa": {
        "enabled": true,
        "name": "itquiz — IT-Begriffe sortieren",
        "short_name": "itquiz",
        "description": "A quiz that helps a layperson sort out IT terms that get mixed up",
        "theme_color": "#4338ca",
        "background_color": "#eef2ff",
        "icon192": "/icons/icon-192.png",
        "icon512": "/icons/icon-512.png"
    }
}
